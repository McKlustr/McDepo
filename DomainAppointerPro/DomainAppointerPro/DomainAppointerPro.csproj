<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>DomainAppointerPro</RootNamespace>
    <AssemblyName>DomainAppointerPro</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputType>Library</OutputType>
    <!-- Pro SDK packaging expects these -->
    <AddInId>{B8E4F2A1-9C3D-4E7F-A1B2-C5D6E7F8A9B0}</AddInId>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Change this if Pro is installed elsewhere -->
    <ProInstallDir Condition="'$(ProInstallDir)' == ''">C:\Program Files\ArcGIS\Pro\</ProInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ArcGIS.Core">
      <HintPath>$(ProInstallDir)bin\ArcGIS.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Core.CIM">
      <HintPath>$(ProInstallDir)bin\ArcGIS.Core.CIM.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Core">
      <HintPath>$(ProInstallDir)bin\Extensions\Core\ArcGIS.Desktop.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Framework is in Pro\bin (Contracts / Button / Module / DockPane live here) -->
    <Reference Include="ArcGIS.Desktop.Framework">
      <HintPath>$(ProInstallDir)bin\ArcGIS.Desktop.Framework.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Mapping">
      <HintPath>$(ProInstallDir)bin\Extensions\Mapping\ArcGIS.Desktop.Mapping.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ArcGIS.Desktop.Editing">
      <HintPath>$(ProInstallDir)bin\Extensions\Editing\ArcGIS.Desktop.Editing.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Config.daml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\DomainAppointer\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Import Pro SDK targets when available (packs .esriAddInX after build) -->
  <Import Project="$(ProInstallDir)bin\Esri.ProApp.SDK.Desktop.targets"
          Condition="Exists('$(ProInstallDir)bin\Esri.ProApp.SDK.Desktop.targets')" />
</Project>
